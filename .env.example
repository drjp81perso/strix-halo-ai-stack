# Copy to .env and replace the secret and group IDs.
AI_API_KEY=replace-with-generated-key-minimum-24-characters
AI_BIND=127.0.0.1
AI_PORT=9292
# Host path containing model weights. Absolute paths are recommended.
# The container always sees this directory as /models (read-only).
MODEL_DIR=/srv/ai-models
VIDEO_GID=44
RENDER_GID=992
# Memory policy. See docs/CUSTOMIZING.md before changing.
# Minimum host MemAvailable required before starting each class.
HEAVY_HOST_RESERVE_GB=20
LIGHT_HOST_RESERVE_GB=16
# Maximum current GTT use tolerated before a new heavyweight/light process starts.
HEAVY_MAX_CURRENT_GTT_GB=4
LIGHT_MAX_CURRENT_GTT_GB=8
TTS_MAX_CURRENT_GTT_GB=12
# llama.cpp automatic fitting reserve and minimum context, in MiB/tokens.
GPU_FIT_TARGET_MIB=4096
MIN_FIT_CONTEXT=16384
# Open WebUI may send chat plus background title/tag/task requests concurrently.
GLOBAL_CONCURRENCY_LIMIT=4
# Automated protocol controls (optional).
PROTOCOL_UNLOAD_WAIT_SECONDS=4
PROTOCOL_MEMORY_RETURN_TOLERANCE_GIB=2.0
PROTOCOL_MAX_HTTP_429=0
