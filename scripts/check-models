#!/usr/bin/env bash
set -Eeuo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd);cd "$ROOT"
json=$(mktemp);trap 'rm -f "$json"' EXIT
python3 scripts/model-manager.py --track active status --json > "$json"
python3 - "$json" <<'PY'
import json,sys
x=json.load(open(sys.argv[1]));bad=[]
for m in x['models']:
 state='OK' if m['managed'] and not m['missing'] else 'UNMANAGED' if not m['managed'] else 'MISSING'
 print(f"{state:<10} {m['id']:<38} files={m['found_files']:<3} bytes={m['bytes']}")
 if m['managed'] and m['missing']:bad.append(m['id'])
print(f"unreferenced files={len(x['orphan_files'])} bytes={x['orphan_bytes']}")
if bad:print('Missing active models:',', '.join(bad),file=sys.stderr);raise SystemExit(1)
PY
