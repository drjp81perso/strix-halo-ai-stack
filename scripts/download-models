#!/usr/bin/env bash
set -Eeuo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
if [[ -f .env ]]; then set -a; source .env; set +a; fi
MODEL_DIR=${MODEL_DIR:-$ROOT/models}
mkdir -p "$MODEL_DIR"
MODEL_DIR=$(cd "$MODEL_DIR" && pwd)
command -v hf >/dev/null || { echo "Install: python3 -m pip install -U huggingface_hub" >&2; exit 1; }
mkdir -p "$MODEL_DIR"/{llm/qwen35,llm/qwen122,llm/coder,vision/qwen3vl,retrieval,speech/whisper,speech/kokoro}

echo "Downloading curated enabled registry (roughly 190 GB)..."
hf download unsloth/Qwen3.5-35B-A3B-GGUF Qwen3.5-35B-A3B-Q5_K_M.gguf --local-dir "$MODEL_DIR"/llm/qwen35
hf download unsloth/Qwen3.5-122B-A10B-GGUF --include 'Q4_K_M/*.gguf' --local-dir "$MODEL_DIR"/llm/qwen122.tmp
mv "$MODEL_DIR"/llm/qwen122.tmp/Q4_K_M/* "$MODEL_DIR"/llm/qwen122/ && rm -rf "$MODEL_DIR"/llm/qwen122.tmp
hf download Qwen/Qwen3-Coder-Next-GGUF --include 'Qwen3-Coder-Next-Q5_K_M/*.gguf' --local-dir "$MODEL_DIR"/llm/coder.tmp
mv "$MODEL_DIR"/llm/coder.tmp/Qwen3-Coder-Next-Q5_K_M/* "$MODEL_DIR"/llm/coder/ && rm -rf "$MODEL_DIR"/llm/coder.tmp
hf download Qwen/Qwen3-VL-32B-Instruct-GGUF Qwen3VL-32B-Instruct-Q4_K_M.gguf mmproj-Qwen3VL-32B-Instruct-Q8_0.gguf --local-dir "$MODEL_DIR"/vision/qwen3vl
hf download Qwen/Qwen3-Embedding-4B-GGUF Qwen3-Embedding-4B-Q8_0.gguf --local-dir "$MODEL_DIR"/retrieval
hf download Voodisss/Qwen3-Reranker-4B-GGUF-llama_cpp Qwen3-Reranker-4B-Q4_K_M.gguf --local-dir "$MODEL_DIR"/retrieval
hf download ggerganov/whisper.cpp ggml-large-v3-turbo-q5_0.bin --local-dir "$MODEL_DIR"/speech/whisper
hf download audio-cpp/audio.cpp-gguf Kokoro-82M-GGUF/kokoro-82m-q8_0.gguf --local-dir "$MODEL_DIR"/speech/kokoro.tmp
mv "$MODEL_DIR"/speech/kokoro.tmp/Kokoro-82M-GGUF/kokoro-82m-q8_0.gguf "$MODEL_DIR"/speech/kokoro/ && rm -rf "$MODEL_DIR"/speech/kokoro.tmp

echo "Downloads complete. Running file checks..."
exec "$ROOT/scripts/check-models"
