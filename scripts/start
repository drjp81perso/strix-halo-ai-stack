#!/usr/bin/env bash
set -Eeuo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd); cd "$ROOT"
[[ -f .env ]] || { cp .env.example .env; echo 'Created .env; edit it and rerun.' >&2; exit 2; }
./scripts/preflight
./scripts/generate-config --check
./scripts/compose-safe build --pull
./scripts/compose-safe run --rm --entrypoint /usr/local/bin/check-runtime-flags gateway
# Recreate so changes in .env/Compose environment reach the gateway.
./scripts/compose-safe up -d --force-recreate
sleep 3
./scripts/compose-safe ps
