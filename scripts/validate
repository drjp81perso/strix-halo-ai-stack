#!/usr/bin/env bash
set -Eeuo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd); cd "$ROOT"
python3 - <<'PY'
import yaml
from pathlib import Path
files = ['compose.yaml','config/llama-swap.yaml'] + [str(p) for p in Path('registry').glob('*.yaml')]
for f in files:
    with open(f) as h: yaml.safe_load(h)
    print('YAML OK',f)
PY
python3 -m json.tool config/audiocpp.json >/dev/null && echo 'JSON OK config/audiocpp.json'
python3 - <<'PY'
from pathlib import Path
import yaml
registry=yaml.safe_load(Path('registry/models.yaml').read_text())['models']
active=yaml.safe_load(Path('tests/models.yaml').read_text())['tests']
planned=yaml.safe_load(Path('tests/planned-models.yaml').read_text())['planned_tests']
ids=[m['id'] for m in registry]
assert len(ids)==len(set(ids)), 'duplicate canonical model IDs'
for model in registry:
    mid=model['id']
    if model.get('enabled'):
        assert mid in active, f'active model missing executable test: {mid}'
        assert model.get('test_status')=='implemented', mid
    else:
        assert mid in planned, f'candidate missing planned test: {mid}'
        assert model.get('test_status')=='planned', mid
print(f'ROSTER/TEST COVERAGE OK active={len(active)} planned={len(planned)}')
PY
./scripts/generate-config --check
python3 scripts/check-docs.py
# Scan every source that can regenerate or document commands, not only rendered config.
if grep -R --line-number --fixed-strings --exclude=runtime-policy.yaml -- '--no-mmap' \
   config templates registry; then
  echo 'ERROR: obsolete --no-mmap found outside its forbidden-flag policy declaration.' >&2
  exit 1
fi
for f in scripts/*; do
  [[ -f "$f" ]] || continue
  case "$f" in
    *.py) python3 -m py_compile "$f"; echo "PYTHON OK $f" ;;
    *) bash -n "$f"; echo "SHELL OK $f" ;;
  esac
done
if docker info >/dev/null 2>&1; then
  cp -n .env.example .env.validation
  docker compose --env-file .env.validation config -q
  rm -f .env.validation
  echo 'COMPOSE OK'
else
  echo 'NOTICE: Docker daemon unavailable; skipped image/runtime validation.'
fi
