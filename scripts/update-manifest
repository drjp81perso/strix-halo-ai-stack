#!/usr/bin/env bash
set -Eeuo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
python3 - "${1:-}" <<'PY'
from pathlib import Path
import hashlib
import subprocess
import sys

root = Path.cwd()
manifest = root / "MANIFEST.sha256"
raw = subprocess.check_output([
    "git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"
])
files = sorted({
    Path(name.decode("utf-8"))
    for name in raw.split(b"\0")
    if name and name != b"MANIFEST.sha256"
})
lines = []
for path in files:
    if not path.is_file():
        continue
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    lines.append(f"{digest}  {path.as_posix()}\n")
content = "".join(lines)

if sys.argv[1] == "--check":
    if not manifest.exists() or manifest.read_text() != content:
        print("MANIFEST.sha256 is out of date; run scripts/update-manifest", file=sys.stderr)
        raise SystemExit(1)
    print("MANIFEST.sha256 is current.")
elif sys.argv[1] in ("", "--write"):
    manifest.write_text(content)
    print(f"Updated MANIFEST.sha256 for {len(lines)} files.")
else:
    print("Usage: scripts/update-manifest [--check|--write]", file=sys.stderr)
    raise SystemExit(2)
PY
