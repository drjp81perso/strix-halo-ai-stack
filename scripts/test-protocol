#!/usr/bin/env bash
set -Eeuo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd);cd "$ROOT"
[[ -f .env ]]||{ echo '.env is required' >&2;exit 2;};set -a;source .env;set +a
BASE="http://${AI_BIND:-127.0.0.1}:${AI_PORT:-9292}";[[ "$BASE" == http://0.0.0.0:* ]]&&BASE="http://127.0.0.1:${AI_PORT:-9292}"
KEY=${AI_API_KEY:?AI_API_KEY missing};suite=${1:-smoke};shift || true;extra_args=("$@");run_id=$(date +%Y%m%d-%H%M%S);dir="benchmark-results/protocol-$run_id";mkdir -p "$dir"
export PROTOCOL_UNLOAD_WAIT_SECONDS="${PROTOCOL_UNLOAD_WAIT_SECONDS:-4}" PROTOCOL_MEMORY_RETURN_TOLERANCE_GIB="${PROTOCOL_MEMORY_RETURN_TOLERANCE_GIB:-2.0}" PROTOCOL_MAX_HTTP_429="${PROTOCOL_MAX_HTTP_429:-0}"
status=pass;tests=0;passed=0;failed=0;suite_start=$(date +%s)
ts(){ date -u +'%Y-%m-%dT%H:%M:%SZ';};duration(){ local s=$1 e=$2;printf '%dm%02ds' $(((e-s)/60)) $(((e-s)%60));}
run(){ local name=$1;shift;tests=$((tests+1));local start end rc;start=$(date +%s);printf '[%s] START %-32s suite=%s test=%d\n' "$(ts)" "$name" "$suite" "$tests";set +e;"$@" >"$dir/$name.log" 2>&1;rc=$?;set -e;end=$(date +%s);if ((rc==0));then passed=$((passed+1));printf '[%s] PASS  %-32s elapsed=%s log=%s\n' "$(ts)" "$name" "$(duration "$start" "$end")" "$dir/$name.log";else failed=$((failed+1));status=fail;printf '[%s] FAIL  %-32s elapsed=%s exit=%d log=%s\n' "$(ts)" "$name" "$(duration "$start" "$end")" "$rc" "$dir/$name.log";tail -60 "$dir/$name.log";fi;}
printf '[%s] SUITE START name=%s run_id=%s endpoint=%s\n' "$(ts)" "$suite" "$run_id" "$BASE"
case "$suite" in
 static) run environment ./scripts/test-environment;run static ./scripts/validate;run coverage ./scripts/test-coverage --strict;;
 smoke) run environment ./scripts/test-environment;run static ./scripts/validate;run health curl -fsS "$BASE/health";run auth-denied bash -c 'code=$(curl -sS -o /dev/null -w "%{http_code}" '"$BASE"'/v1/models);[[ "$code" == 401 ]]';run discovery curl -fsS -H "Authorization: Bearer $KEY" "$BASE/v1/models";run fast python3 tests/run.py llm/fast --base "$BASE" --key "$KEY";;
 active) run environment ./scripts/test-environment;run static ./scripts/validate;while read -r model;do run "${model//\//__}" python3 tests/run.py "$model" --base "$BASE" --key "$KEY";done < <(python3 - <<'PY'
import yaml
print(*yaml.safe_load(open('tests/protocol.yaml'))['suites']['active']['models'],sep='\n')
PY
);;
 exposed) run environment ./scripts/test-environment;run static ./scripts/validate;run exposed python3 -u tests/exposed.py --base "$BASE" --key "$KEY" --output "$dir/exposed.json" "${extra_args[@]}";;
 openwebui) run environment ./scripts/test-environment;run static ./scripts/validate;run burst python3 -u tests/openwebui_burst.py --base "$BASE" --key "$KEY" --output "$dir/burst.json";;
 full) "$0" static;"$0" smoke;"$0" exposed;"$0" openwebui;exit;;
 soak) for i in 1 2 3;do run "active-$i" "$0" active;done;;
 *) echo 'Usage: ./scripts/test-protocol {static|smoke|active|exposed|openwebui|full|soak} [exposed filters]' >&2;exit 2;;esac
suite_end=$(date +%s)
python3 - "$suite" "$run_id" "$status" "$tests" "$passed" "$failed" "$dir" "$suite_start" "$suite_end" <<'PY'
import json,sys,pathlib,os
suite,run,status,tests,passed,failed,out,start,end=sys.argv[1:];d={'suite':suite,'run_id':run,'status':status,'tests':int(tests),'passed':int(passed),'failed':int(failed),'elapsed_seconds':int(end)-int(start),'effective_policy':{k:('***' if k=='AI_API_KEY' else os.environ.get(k)) for k in ['AI_API_KEY','HEAVY_HOST_RESERVE_GB','LIGHT_HOST_RESERVE_GB','HEAVY_MAX_CURRENT_GTT_GB','LIGHT_MAX_CURRENT_GTT_GB','TTS_MAX_CURRENT_GTT_GB','GPU_FIT_TARGET_MIB','MIN_FIT_CONTEXT','GLOBAL_CONCURRENCY_LIMIT','PROTOCOL_UNLOAD_WAIT_SECONDS','PROTOCOL_MEMORY_RETURN_TOLERANCE_GIB','PROTOCOL_MAX_HTTP_429']}};pathlib.Path(out,'summary.json').write_text(json.dumps(d,indent=2));print(json.dumps(d,indent=2))
PY
printf '[%s] SUITE %s name=%s elapsed=%s passed=%d failed=%d report=%s/summary.json\n' "$(ts)" "${status^^}" "$suite" "$(duration "$suite_start" "$suite_end")" "$passed" "$failed" "$dir"
[[ "$status" == pass ]]
